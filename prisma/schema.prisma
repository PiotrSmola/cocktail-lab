generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Unit {
  ML
  CL
  L
  OZ
  TSP
  TBSP
  CUP
  SHOT
  JIGGER
  PART
  DASH
  SPLASH
  DROP
  PINCH
  GRAM
  CAN
  BOTTLE
  GLASS
  SCOOP
  PIECE
}

model Cocktail {
  id               Int                    @id @default(autoincrement())
  externalId       String                 @unique
  slug             String                 @unique
  name             String
  nameSort         String                 @default("")
  category         String?
  glass            String?
  iba              String?
  tags             String[]
  isAlcoholic      Boolean                @default(true)
  instructions     String
  imageUrl         String?
  imageIsCC        Boolean                @default(false)
  imageAttribution String?
  sourceModifiedAt DateTime?
  abv              Float?
  abvEstimated     Boolean                @default(true)
  dilutionMethod   String?
  ingredients      CocktailIngredient[]
  favorites        Favorite[]
  notes            Note[]

  @@index([category])
  @@index([isAlcoholic])
  @@index([nameSort])
  @@index([glass])
  @@index([abv])
}

model Ingredient {
  id           Int                    @id @default(autoincrement())
  slug         String                 @unique
  name         String
  nameSort     String                 @default("")
  type         String?
  groupSlug    String?
  isAlcoholic  Boolean                @default(false)
  abv          Float?
  abvEstimated Boolean                @default(false)
  description  String?
  imageUrl     String?
  cocktails    CocktailIngredient[]
  pantryItems  PantryItem[]

  @@index([groupSlug])
  @@index([isAlcoholic])
  @@index([nameSort])
}

model CocktailIngredient {
  cocktailId   Int
  ingredientId Int
  position     Int
  amount       Float?
  amountMax    Float?
  unit         Unit?
  amountMl     Float?
  rawMeasure   String
  note         String?
  optional     Boolean                @default(false)
  garnish      Boolean                @default(false)
  toTaste      Boolean                @default(false)
  topUp        Boolean                @default(false)
  cocktail     Cocktail               @relation(fields: [cocktailId], references: [id], onDelete: Cascade)
  ingredient   Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([cocktailId, position])
  @@index([ingredientId])
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  favorites    Favorite[]
  notes        Note[]
  pantryItems  PantryItem[]
}

model PantryItem {
  userId       Int
  ingredientId Int
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([userId, ingredientId])
  @@index([ingredientId])
}

model Favorite {
  userId     Int
  cocktailId Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cocktail   Cocktail @relation(fields: [cocktailId], references: [id], onDelete: Cascade)

  @@id([userId, cocktailId])
  @@index([cocktailId])
}

model Note {
  userId     Int
  cocktailId Int
  body       String
  rating     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cocktail   Cocktail @relation(fields: [cocktailId], references: [id], onDelete: Cascade)

  @@id([userId, cocktailId])
  @@index([cocktailId])
}
