POSTGRES_USER=cocktail
POSTGRES_PASSWORD=cocktail
POSTGRES_DB=cocktail_lab
POSTGRES_PORT=5433

APP_PORT=3000
ADMINER_PORT=8081

# Minimum 32 characters. Replace before using outside local development.
NUXT_SESSION_PASSWORD=local-development-session-secret-change-me

# Signs social share image URLs. Generate with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=cocktail-lab-og-image-local

# Only set to true behind a reverse proxy that overwrites x-forwarded-for,
# otherwise clients can spoof the header and bypass auth rate limiting.
TRUST_PROXY=false
