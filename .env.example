# Copy to .env before the first `docker compose up`.
#
# Two kinds of variable live in this file:
#   (a) values docker-compose.yml interpolates when it builds the stack
#       (credentials, ports, and the DATABASE_URL it assembles for the app);
#   (b) values the app itself reads at runtime, which only reach the container
#       if they are listed in the `app` service's `environment:` block.
# Where a variable is (b) but not yet forwarded, it is called out below.

# --- Postgres + published ports (read by docker-compose.yml) ------------------
# The app's DATABASE_URL is assembled from these three, so change them together
# or not at all. All ports bind to 127.0.0.1 only.
POSTGRES_USER=cocktail
POSTGRES_PASSWORD=cocktail
POSTGRES_DB=cocktail_lab
POSTGRES_PORT=5433

APP_PORT=3000
ADMINER_PORT=8081

# --- Runtime configuration (read by the app) ---------------------------------

# Seals the session cookie (nuxt-auth-utils). Minimum 32 characters — the module
# refuses to boot below that. Forwarded to the container by docker-compose.yml.
# Replace before using outside local development.
NUXT_SESSION_PASSWORD=local-development-session-secret-change-me

# Signs social share image URLs (@nuxtjs/og-image), read in nuxt.config.ts.
# Generate with: npx nuxt-og-image generate-secret
# NOT currently forwarded by docker-compose.yml — inside the container the code
# default ('cocktail-lab-og-image-local') applies until you add it to the `app`
# service's `environment:` block.
NUXT_OG_IMAGE_SECRET=cocktail-lab-og-image-local

# Gates whether the auth rate limiter trusts the x-forwarded-for header
# (server/utils/rateLimit.ts). Only set to true behind a reverse proxy that
# OVERWRITES that header — otherwise any client can spoof it and get a fresh
# rate-limit bucket per request.
# NOT currently forwarded by docker-compose.yml; the code default is "off",
# which is the safe direction.
TRUST_PROXY=false

# --- Set for you by docker-compose.yml; only needed if you run without Docker --
# DATABASE_URL=postgresql://cocktail:cocktail@localhost:5433/cocktail_lab?schema=public
# NUXT_PUBLIC_SITE_URL=http://localhost:3000
